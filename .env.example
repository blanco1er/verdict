# Copy to .env.local (git-ignored). Never commit real values.
# Default is mock mode: no key, no network, no units spent.
YOUCAM_MODE=mock
# Fill locally once the hackathon account exists (yce.makeupar.com > API Keys).
YOUCAM_API_KEY=
# Local guard on units this server may spend (hackathon grant: 1000).
YOUCAM_UNIT_CAP=100
# Set to 1 only for the judged deployment (per-visitor quota still applies).
YOUCAM_PUBLIC_LIVE=0
